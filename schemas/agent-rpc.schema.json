{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dewu-price-check.example/schemas/agent-rpc.schema.json",
  "title": "Sanitized Agent RPC envelope v1",
  "type": "object",
  "required": ["operation", "correlationId", "payload"],
  "properties": {
    "operation": { "enum": ["health", "searchBySku", "getProduct", "getQuotes"] },
    "correlationId": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
